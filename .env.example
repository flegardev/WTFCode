# Canonical production configuration (Supabase session pooler or direct PostgreSQL).
APP_ENV=production
APP_DEBUG=false
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSLMODE=require
WTF_STORAGE_PATH=/tmp/wtfcode
WTF_SCAN_PROFILE=quick

# Optional. Relative URLs keep Vercel previews working when APP_URL is empty.
APP_URL=
APP_VERSION=
SESSION_DRIVER=database
SESSION_LIFETIME=7200

# GitHub App private repository access. Configure the App with Contents: read-only,
# request user authorization during installation, and the exact callback URL below.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_CALLBACK_URL=https://your-domain.example/github-callback.php

# Optional explanation providers. Deterministic is the safe default.
WTF_CODE_EXPLANATION_PROVIDER=deterministic
WTF_CODE_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
WTF_CODE_OPENAI_MODEL=gpt-4.1-mini
WTF_CODE_OPENAI_API_KEY=
WTF_CODE_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
WTF_CODE_OLLAMA_MODEL=llama3.2

# Legacy local MySQL development remains supported by the PHP compatibility layer.
# Do not set DATABASE_URL when using these values.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=wtfcode
# DB_USERNAME=root
# DB_PASSWORD=
