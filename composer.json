{
  "name": "flegardev/wtfcode",
  "description": "Evidence-fusing code intelligence for AI-built applications.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "nikic/php-parser": "^5.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.23",
    "phpstan/phpstan": "^2.2.9",
    "phpunit/phpunit": "^11.5.56"
  },
  "autoload": {
    "psr-4": {
      "WTFCode\\Application\\": "src/Application/",
      "WTFCode\\Http\\": "src/Http/",
      "WTFCode\\Repository\\": "src/Repository/",
      "WTFCode\\Scanning\\": "src/Scanning/"
    },
    "classmap": [
      "src/"
    ],
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WTFCode\\Tests\\Unit\\": "tests/Unit/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
    "format": "php-cs-fixer fix --config=.php-cs-fixer.php --using-cache=no",
    "format:check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff --using-cache=no",
    "lint": "@php tools/lint.php",
    "test": [
      "@test:unit",
      "@test:portable"
    ],
    "test:all": [
      "@test",
      "@test:analyzers",
      "@test:integration",
      "@test:security",
      "@test:e2e"
    ],
    "test:analyzers": "@php tools/run-test-tier.php analyzers",
    "test:e2e": "@php tools/run-test-tier.php e2e",
    "test:integration": "@php tools/run-test-tier.php integration",
    "test:portable": "@php tools/run-test-tier.php portable",
    "test:production": "@php tests/PostgresProductionTest.php",
    "test:security": "@php tools/run-test-tier.php security",
    "test:unit": "phpunit --configuration=phpunit.xml.dist --testsuite=unit",
    "verify": [
      "@lint",
      "@test",
      "@analyse",
      "@format:check"
    ],
    "worker": "@php tools/scan-worker.php --loop",
    "worker:once": "@php tools/scan-worker.php --once"
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  }
}
